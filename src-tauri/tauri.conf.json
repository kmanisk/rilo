{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rilo",
  "version": "1.1.0",
  "identifier": "com.rilo.downloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rilo",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 550,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rilo",
    "copyright": "Copyright © 2026 Rilo. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Modern, Blazing Fast Download Manager",
    "longDescription": "Rilo is a modern, high-performance download manager featuring dynamic multi-connection segmentation, smart category organization, and browser integration.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
